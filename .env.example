# FinExtract-Bench Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///./finextract.db

# PostgreSQL (replace SQLite URL when ready):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/finextract

# ── LLM Provider ──────────────────────────────────────────────────────
# Options: mock | openai | anthropic | google
# 'mock' works without any API key and is the default.
LLM_PROVIDER=mock
LLM_MODEL=mock-model-v1

# ── API Keys (only needed for non-mock providers) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── LLM Behavior ──────────────────────────────────────────────────────
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60.0

# ── Parsing ───────────────────────────────────────────────────────────
DOCLING_DO_TABLE_STRUCTURE=true
DOCLING_DO_OCR=false

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
